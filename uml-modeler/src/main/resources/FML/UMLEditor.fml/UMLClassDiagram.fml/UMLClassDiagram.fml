/**
 * UMLClassDiagram - the class-diagram view of a UMLModel. A class is drawn as a composite shape:
 * a main container holding an icon, a header, a properties compartment and an operations one.
 *
 * Migrated from the deprecated .fml.xml serialization to textual FML. What was repaired, and why:
 *
 *   - The FMLRT model slot was named "model", which the 2.99 grammar reserves, and so was the
 *     parameter of the creation scheme; both are now "umlModel" / "aModel".
 *
 *   - The five <ParentShapeRole idref="…"/> nested in the shape roles are not roles: they are the
 *     containment assertion, and become containerElement=main. The drop scheme already adds those
 *     five shapes with container=main, so assertion and behaviour agree here.
 *
 *   - Two of the three palette element bindings pointed at palette elements that do not exist
 *     ("ClassGR" and "TotoGR" - the palette declares only "Class") AND carried no drop scheme.
 *     Both are dropped; the remaining one binds "Class" to dropClassGRAtTopLevel.
 *
 *   - templateDiagram is preserved: TypedDiagramModelSlot gained the matching FML attribute, so the
 *     legacy templateDiagramReference (…/ExampleDiagram.diagram#SYL_1) still applies.
 */

namespace "http://openflexo.org/uml-modeler/DiagramSpecs/UMLClassDiagramSpecification.diagramspecification" as UML_CLASS_DIAGRAM_SPECIFICATION;

use org.openflexo.foundation.fml.rt.FMLRTModelSlot as FMLRT;
use org.openflexo.technologyadapter.diagram.TypedDiagramModelSlot as DIAGRAM;

import org.openflexo.technologyadapter.diagram.model.Diagram;
import org.openflexo.technologyadapter.diagram.model.DiagramShape;
import org.openflexo.technologyadapter.diagram.metamodel.DiagramSpecification;
import java.lang.String;

import ["http://openflexo.org/uml-modeler/FML/UMLEditor.fml/UMLModel.fml"];

import DiagramSpecification UML_CLASS_DIAGRAM_SPEC from [UML_CLASS_DIAGRAM_SPECIFICATION];
import Diagram EXAMPLE_DIAGRAM from [UML_CLASS_DIAGRAM_SPECIFICATION + "/ExampleDiagram.diagram"];
import DiagramShape MAIN_SHAPE from [EXAMPLE_DIAGRAM:"SYL-2"];
import DiagramShape ICON_SHAPE from [EXAMPLE_DIAGRAM:"SYL-3"];
import DiagramShape HEADER_SHAPE from [EXAMPLE_DIAGRAM:"SYL-4"];
import DiagramShape PROPERTIES_SHAPE from [EXAMPLE_DIAGRAM:"SYL-5"];
import DiagramShape OPERATIONS_SHAPE from [EXAMPLE_DIAGRAM:"SYL-6"];
import DiagramShape HEADER_OUTLINE_SHAPE from [EXAMPLE_DIAGRAM:"SYL-7"];

@URI("http://openflexo.org/uml-modeler/FML/UMLEditor.fml/UMLClassDiagram.fml")
@Version("0.1")
public model UMLClassDiagram {

	// The UML model this diagram represents
	UMLModel umlModel with ModelInstance(isRequired=true);

	Diagram diagram with TypedDiagram(
		diagramSpecification=UML_CLASS_DIAGRAM_SPEC,
		templateDiagram=EXAMPLE_DIAGRAM,
		isRequired=true,
		paletteElementBindings={
			PaletteElementBinding:(
				call=new ClassGR::dropClassGRAtTopLevel(),
				paletteElementId="http://openflexo.org/uml-modeler/DiagramSpecs/UMLClassDiagramSpecification.diagramspecification/Palette.palette#Class")
		});

	create::init(UMLModel aModel) {
		diagram = DIAGRAM::CreateDiagram(resourceName="diagram",resourceCenter=this.resourceCenter,relativePath="/Diagrams");
		umlModel = parameters.aModel;
	}

	/**
	 * Draws a Class as a composite shape
	 */
	public concept ClassGR {

		DiagramShape main with ShapeRole(metamodelElement=MAIN_SHAPE,exampleLabel="");
		DiagramShape icon with ShapeRole(metamodelElement=ICON_SHAPE,exampleLabel="",containerElement=main);
		DiagramShape header with ShapeRole(metamodelElement=HEADER_SHAPE,exampleLabel="Class",label=class.name,containerElement=main);
		DiagramShape properties with ShapeRole(metamodelElement=PROPERTIES_SHAPE,exampleLabel="<properties>",containerElement=main);
		DiagramShape operations with ShapeRole(metamodelElement=OPERATIONS_SHAPE,exampleLabel="<operations>",containerElement=main);
		DiagramShape headerOutline with ShapeRole(metamodelElement=HEADER_OUTLINE_SHAPE,exampleLabel="HeaderOutline",containerElement=main);

		UMLClass class with ConceptInstance(virtualModelInstance=umlModel);

		ClassGR dropClassGRAtTopLevel() with DropScheme(targetType=UMLClassDiagram) {
			main = DIAGRAM::AddShape(container=topLevel) in diagram;
			icon = DIAGRAM::AddShape(container=main) in diagram;
			header = DIAGRAM::AddShape(container=main) in diagram;
			properties = DIAGRAM::AddShape(container=main) in diagram;
			operations = DIAGRAM::AddShape(container=main) in diagram;
			headerOutline = DIAGRAM::AddShape(container=main) in diagram;
			class = umlModel.new UMLClass("Class");
		}
	}

}
