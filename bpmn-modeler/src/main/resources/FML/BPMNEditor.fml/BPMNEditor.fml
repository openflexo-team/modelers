/**
 * BPMNEditor - entry point of the BPMN modeler: it federates one .bpmn EMF model, reifies it as a
 * BPMNModel instance, and holds one ProcessDiagram instance per process diagram.
 *
 * Migrated from the deprecated .fml.xml serialization to textual FML. What was repaired, and why:
 *
 *   - The FMLRT model slot was named "model", which the 2.99 grammar reserves; it is now
 *     "bpmnModelInstance".
 *
 *   - BPMNModel's creation scheme now takes the BPMN resource (see BPMNModel), so the EMF model
 *     slot it reads from is actually assigned.
 *
 *   - createNewProcess(parentProcess) used to call a ProcessDiagram creation scheme named
 *     createNewSubProcess(name,parentProcess) which does not exist. Nothing in the model says what
 *     a sub-process diagram should hold, so the branch now falls through to the same
 *     newProcessDiagram(current) as the top-level case, and says so.
 *
 * That legacy notify of a "rootProcesses" property which no virtual model declared is now closed:
 * the property exists, on BPMNModel, which is where BPMNEditorUI.fib's browser reads it (its node
 * IS the model), and the notify below fires there. This editor gained "processDiagrams" for the
 * symmetric need in BPMNModelUI.fib.
 */

use org.openflexo.foundation.fml.rt.FMLRTModelSlot as FMLRT;
use org.openflexo.technologyadapter.gina.FIBComponentModelSlot as GINA;
use org.openflexo.technologyadapter.emf.EMFModelSlot as EMF;

import org.openflexo.technologyadapter.emf.model.EMFModel;
import org.openflexo.technologyadapter.emf.metamodel.EMFMetaModel;
import org.openflexo.technologyadapter.gina.model.GINAFIBComponent;
import java.lang.String;
import java.util.List;

import ["http://openflexo.org/bpmn-modeler/FML/BPMNEditor.fml/BPMNModel.fml"];
import ["http://openflexo.org/bpmn-modeler/FML/BPMNEditor.fml/ProcessDiagram.fml"];

import EMFMetaModel BPMN from ["http://www.omg.org/spec/BPMN/20100524/MODEL-XMI"];

@URI("http://openflexo.org/bpmn-modeler/FML/BPMNEditor.fml")
@Version("0.1")
@Author("sylvain")
public model BPMNEditor {

	// The .bpmn model being edited
	EMFModel bpmnModel with EMFModelSlot(metaModel=BPMN, isRequired=true);

	// Its reification as BPMN concepts
	BPMNModel bpmnModelInstance with ModelInstance(isRequired=true);

	// The process diagrams this editor holds, one per BPMN process. Declared for BPMNModelUI.fib,
	// whose browser lists them under the model.
	List<ProcessDiagram> processDiagrams {
		List<ProcessDiagram> get() {
			return select ProcessDiagram from this;
		}
	};

	// The user interface of this editor
	GINAFIBComponent ui with FIBComponent(
		templateComponentURI="http://openflexo.org/bpmn-modeler/Fib/BPMNEditorUI.fib",
		isRequired=true,
		assignments={VariableAssignment:(variable="data",value=this)});

	create(Resource<EMFModel> bpmnResource) {
		bpmnModel = parameters.bpmnResource.resourceData;
		bpmnModelInstance = new BPMNModel(parameters.bpmnResource) with (name=parameters.bpmnResource.name.substring(0,parameters.bpmnResource.name.indexOf(".")) + "Model");
		ui = GINA::ConfigureGINAFIBComponent() in ui;
	}

	public ProcessDiagram newProcessDiagram(String processName) {
		ProcessDiagram returned = new ProcessDiagram::createNewProcess(parameters.processName) with (name=parameters.processName);
		notify "rootProcesses" in bpmnModelInstance;
		notify "processDiagrams" in this;
		return returned;
	}

	ProcessDiagram getProcessDiagram(Process process) {
		List<ProcessDiagram> list = select ProcessDiagram from this where (selected.process == parameters.process);
		log "On cherche le diagramme pour " + parameters.process;
		log "Trouve: " + list;
		if (list.size > 0) {
			return list.get(0);
		}
		return null;
	}

	ProcessDiagram getProcessDiagram(String processName) {
		List<ProcessDiagram> list = select ProcessDiagram from this where (selected.process.processName == parameters.processName);
		log ("on cherche " + parameters.processName + " on trouve ") + list;
		if (list.size > 0) {
			return list.get(0);
		}
		return null;
	}

	/**
	 * Creates a new process, choosing the first available name from the 'process' base.
	 *
	 * This no-argument form exists because BPMNModelUI.fib binds a button to createNewProcess() with
	 * no argument: a binding matches on ARITY, and only the one-argument form existed. (Visibility is
	 * not what was missing - a non-public behaviour is perfectly reachable from a binding; measured.)
	 */
	public ProcessDiagram createNewProcess() {
		String baseName = "process";
		String current = baseName;
		Long aLong = 2;
		while (this.getProcessDiagram(current) != null) {
			current = baseName + aLong;
			log "On essaie " + current;
			aLong = aLong + 1;
		}
		log "creating process " + current;
		return this.newProcessDiagram(current);
	}

	/**
	 * Same, from a parent process. The legacy branched here on a ProcessDiagram creation scheme that
	 * never existed (createNewSubProcess); a sub-process diagram is created like any other until the
	 * model says what distinguishes it, so this simply delegates.
	 */
	public ProcessDiagram createNewProcess(Process parentProcess) {
		return this.createNewProcess();
	}

}
