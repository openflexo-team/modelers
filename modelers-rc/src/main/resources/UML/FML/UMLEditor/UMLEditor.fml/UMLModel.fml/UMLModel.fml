/**
 * UMLModel - a deliberately minimal UML class model: classes and their properties, expressed in
 * pure FML (no UML technology adapter is involved, and none exists in 2.99).
 *
 * Migrated from the deprecated .fml.xml serialization to textual FML. The creation and deletion
 * schemes are anonymous, and <Inspector> elements were dropped (FlexoConceptInspector is
 * deprecated).
 */

import java.lang.String;

@URI("http://openflexo.org/modellers/resources/UMLEditor/UMLEditor.viewpoint/UMLModel.fml")
@Version("0.1")
@Author("sylvain")
public model UMLModel {

	create() {
	}

	public concept Class {

		String name;
		Property[0,*] properties with ConceptInstance(virtualModelInstance=container);

		create(String aName) {
			name = parameters.aName;
		}

		delete() {
			name = null;
		}
	}

	public concept Property {

		String name;

		create(String aName) {
			name = parameters.aName;
		}

		delete() {
			name = null;
		}
	}

}
