/**
 * StateChartModel - the abstract syntax of a state chart: states and the transitions between them.
 *
 * Migrated from the deprecated .fml.xml serialization to textual FML. What was repaired, and why:
 *   - Transition's role "from" is renamed "fromState": "from" is a reserved word of the 2.99
 *     grammar (the "from" clause of select/match), so a role cannot keep that name. "to" is not
 *     reserved, but is renamed "toState" in both Transition and InitialTransition so that the
 *     model stays internally consistent;
 *   - Transition's creation scheme declared its two state parameters as
 *     FlexoConceptInstanceType<null> - the concept had been lost in the legacy XML. They are
 *     State, as InitialTransition's own parameter already was;
 *   - the creation and deletion schemes are anonymous, so that a subclass could reach them
 *     through super(...);
 *   - <Inspector> / <InspectorEntry> elements were dropped: FlexoConceptInspector is deprecated
 *     and has no textual form.
 */

import java.lang.String;
import java.util.List;

@URI("http://openflexo.org/statecharts-modeler/FML/StateCharts.fml/StateChartModel.fml")
@Version("0.1")
@Author("sylvain")
public model StateChartModel {

	// The single initial transition of this state chart, if any
	InitialTransition initialTransition {
		InitialTransition get() {
			return select unique InitialTransition from this;
		}
	};

	create() {
	}

	delete() {
	}

	/**
	 * A state of the state chart
	 */
	public concept State {

		String[1,1] name;

		List<Transition> incomingTransitions {
			List<Transition> get() {
				return select Transition from container where (selected.toState == this);
			}
		};

		List<Transition> outgoingTransitions {
			List<Transition> get() {
				return select Transition from container where (selected.fromState == this);
			}
		};

		create(String aName) {
			name = parameters.aName;
		}

		delete() {
			name = null;
		}
	}

	/**
	 * A transition between two states
	 */
	public concept Transition {

		State[1,1] fromState;
		State[1,1] toState;
		String label;

		create(State aFrom, State aTo, String aLabel) {
			fromState = parameters.aFrom;
			toState = parameters.aTo;
			label = parameters.aLabel;
		}

		delete() {
		}
	}

	/**
	 * The transition entering the initial state of the state chart
	 */
	public concept InitialTransition {

		State[1,1] toState;
		String label;

		create(State aTo, String aLabel) {
			toState = parameters.aTo;
			label = parameters.aLabel;
		}

		delete() {
		}
	}

}
